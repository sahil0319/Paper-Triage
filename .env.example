# Required: which LLM provider to use (anthropic | openai). Picks the default model.
LLM_PROVIDER=
# Required: API key for the chosen provider
AGENT_API_KEY=
# Optional: model id; blank = claude-opus-5-5 (anthropic) or gpt-5-mini (openai)
AGENT_MODEL=

# MOCK_LLM=1 uses canned responses and needs none of the three above
MOCK_LLM=1
PAPER_TRIAGE_DB=

# Where saved PDFs are stored (default ./paper_triage_data)
PAPER_TRIAGE_DATA_DIR=
